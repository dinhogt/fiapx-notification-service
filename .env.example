# Valores FICTÍCIOS para o ambiente local (docker compose). Nunca use valores reais aqui.
NODE_ENV=development
APP_ENV=local
PORT=3004
LOG_LEVEL=info
DATABASE_URL=postgresql://notification_svc:change-me@localhost:5432/fiapx?schema=notification&connection_limit=5&sslmode=disable
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=notification-service
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=fiapx-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
TRUST_GATEWAY_IP=false
NOTIFICATIONS_QUEUE_URL=http://localhost:4566/000000000000/fiapx-local-notifications
USER_CONTACTS_QUEUE_URL=http://localhost:4566/000000000000/fiapx-local-user-contacts
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
